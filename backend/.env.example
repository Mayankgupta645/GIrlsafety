PORT=5000

# Set DATABASE_URL or the individual DB_* values below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saferoute
DB_USER=postgres
DB_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EMERGENCY_PHONE=

# Set this to your deployed frontend origin when frontend and backend use different hosts.
CORS_ORIGIN=*

# demo simulates an SOS without placing a real call; set to twilio only when configured.
SOS_MODE=demo
